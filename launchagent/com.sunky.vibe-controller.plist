<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sunky.vibe-controller</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but allow manual quit (via menu) without auto-restart. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Interactive, not Background: a Background-role process has its
         dispatch timers coalesced by the kernel to ~100ms, which turns the
         120Hz cursor timer into a 10Hz stutter. See docs/pitfalls.md. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/vibe-controller.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/vibe-controller.err</string>
</dict>
</plist>
